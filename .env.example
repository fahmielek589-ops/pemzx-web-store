# ============================================================
# PEMZX — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — NEVER commit real credentials.
# Nothing in this project reads a username or password from
# source code. Everything credential-shaped lives here only.
# ============================================================

# --- Database (Postgres — works with Supabase, Neon, Railway, etc.) ---
# Get this connection string from your provider's dashboard.
DATABASE_URL="postgresql://user:password@host:5432/pemzx?schema=public"

# --- Session security ---
# Random 32+ byte secret used to sign session tokens.
# Generate one with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-generated-secret"

# --- Initial admin seed (used ONCE by `npm run db:seed`) ---
# These two values are read only by scripts/seed-admin.ts at setup time.
# The script immediately hashes ADMIN_PASSWORD with Argon2id and stores
# only the hash in the database — the plaintext value is never persisted
# and never appears anywhere in the source code.
# You may remove these two lines from `.env` after seeding once.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password-here"

# --- App ---
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NODE_ENV="development"
